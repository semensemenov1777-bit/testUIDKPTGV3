-- StarterGui.PTG.Osnova2.Skybox.TextBox.LocalScript
local function C_24()
local script = G2L["24"];
	local button = script.Parent
	local decalsFrame = button.Parent
	local textBox = decalsFrame:FindFirstChild("TextBox")
	local imageLabel = decalsFrame:FindFirstChild("ImageLabel")
	local remote = button:FindFirstChild("DecalEvent")
	
	-- Store the current decal ID
	local currentDecalId = nil
	
	-- When player types in TextBox and presses Enter, load the image preview
	if textBox then
		textBox.FocusLost:Connect(function(enterPressed)
			if not enterPressed then return end
			local input = textBox.Text
			-- Extract numeric ID from input (supports "rbxassetid://123" or just "123")
			local id = string.match(input, "%d+")
			if id then
				currentDecalId = id
				if imageLabel then
					imageLabel.Image = "rbxassetid://" .. id
				end
			end
		end)
	end
	
	-- When Execute button is clicked, send the decal ID to the server
	button.MouseButton1Click:Connect(function()
		if currentDecalId and remote then
			remote:FireServer(currentDecalId)
		end
	end)
	
end;
task.spawn(C_24);
