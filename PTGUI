local function C_90()
local script = G2L["90"];
	local frame = script.Parent
	local gui = frame.Parent
	local player = game.Players.LocalPlayer
	local playerGui = player:WaitForChild("PlayerGui")
	
	-- Function to get random position on screen
	local function getRandomPosition()
		local viewportSize = workspace.CurrentCamera.ViewportSize
		local frameSize = frame.AbsoluteSize
	
		local maxX = viewportSize.X - frameSize.X
		local maxY = viewportSize.Y - frameSize.Y
	
		if maxX <= 0 then maxX = 1 end
		if maxY <= 0 then maxY = 1 end
	
		local randomX = math.random(0, maxX)
		local randomY = math.random(0, maxY)
	
		return UDim2.new(0, randomX, 0, randomY)
	end
	
	-- Function for smooth movement
	local function moveToRandomPosition()
		local targetPosition = getRandomPosition()
	
		local tweenInfo = TweenInfo.new(
			1,
			Enum.EasingStyle.Quad,
			Enum.EasingDirection.Out
		)
	
		local tween = game:GetService("TweenService"):Create(frame, tweenInfo, {
			Position = targetPosition
		})
	
		tween:Play()
	
		tween.Completed:Connect(function()
			task.wait(math.random(1, 3))
			if frame and frame.Parent then
				moveToRandomPosition()
			end
		end)
	end
	
	-- Initial positioning
	frame.Position = getRandomPosition()
	
	-- Start moving
	moveToRandomPosition()
end;
